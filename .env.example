# Приклад: application читає environment; .env автоматично не завантажується.
# Обидва Telegram-поля порожні: локальний monitoring без notifications.
RF_SENTINEL_TELEGRAM_BOT_TOKEN=
RF_SENTINEL_TELEGRAM_CHAT_ID=
RF_SENTINEL_REPORT_INTERVAL_MINUTES=30
RF_SENTINEL_RTL_DEVICE_INDEX=0
RF_SENTINEL_RTL_GAIN=auto
RF_SENTINEL_DATA_DIR=runtime
RF_SENTINEL_SURVEY_START_HZ=24000000
RF_SENTINEL_SURVEY_STOP_HZ=1766000000
RF_SENTINEL_SURVEY_BIN_HZ=500000
RF_SENTINEL_SURVEY_INTEGRATION_SECONDS=60
RF_SENTINEL_SURVEY_DURATION_SECONDS=1800
RF_SENTINEL_TELEGRAM_ATTEMPTS=3
RF_SENTINEL_TELEGRAM_BACKOFF_SECONDS=5
RF_SENTINEL_SURVEY_RECOVERY_SECONDS=60
RF_SENTINEL_TIMEZONE=Europe/Kyiv
